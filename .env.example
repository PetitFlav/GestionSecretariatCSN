# ─────────────────────────────────────────────────────────────────────────────
# Gestion Secrétariat CSN — variables d'environnement
# Copier en .env (ou créer en secrets Codespaces / variables hébergeur).
# ⚠️ Ne JAMAIS mettre de vraies valeurs dans ce fichier : il est commité.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données (Neon) ──────────────────────────────────────────────────
# Neon → branche → Connect.
# DATABASE_URL : "Connection pooling" ACTIVÉ  (hôte en ...-pooler)  → requêtes de l'appli
# DIRECT_URL   : "Connection pooling" DÉSACTIVÉ (hôte sans -pooler) → migrations Prisma
# Dev = branche Neon "dev" ; Prod = branche "production".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# ── Sécurité ────────────────────────────────────────────────────────────────
# Secret des cookies de session (≥ 32 caractères). Générer : openssl rand -base64 32
# Peut (doit) être différent entre dev et prod.
SESSION_SECRET="changer-cette-valeur-par-une-chaine-aleatoire-longue"

# Clé de chiffrement des données personnelles (email, DDN, adresse, configs SMTP).
# ⚠️ Doit être IDENTIQUE en dev et en prod (la base dev est une copie de la prod).
# ⚠️ La perdre = données chiffrées illisibles. À conserver dans un gestionnaire de mots de passe.
ENCRYPTION_KEY="changer-cette-valeur-par-une-cle-aleatoire"

# ── URL publique de l'application ───────────────────────────────────────────
# Utilisée dans les liens des emails (invitation, mot de passe oublié).
# Intégrée au build : redéployer après modification.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── SMTP club : emails système ──────────────────────────────────────────────
# Invitations, mot de passe oublié, notifications admin.
# (Les attestations et rappels CACI utilisent le SMTP perso de chaque utilisateur,
#  configuré dans l'appli : Config → Mon compte email.)
# Gmail : smtp.gmail.com / 587 + mot de passe d'application (pas le mdp du compte).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
# Optionnel : "true" pour forcer SSL (par défaut : true si port 465, sinon STARTTLS)
# SMTP_SECURE="false"
SMTP_USER="secretariat.csn@gmail.com"
SMTP_PASS=""
SMTP_FROM="Secrétariat CSN <secretariat.csn@gmail.com>"

# ── Optionnel ───────────────────────────────────────────────────────────────
# Corps de l'email d'attestation (sinon template par défaut).
# Variables disponibles : {prenom} {nom} {saison}
# EMAIL_BODY_TEMPLATE="Bonjour {prenom},\n\nVeuillez trouver ci-joint votre attestation de paiement pour la saison {saison}.\n\nCordialement,\nLe secrétariat du Centre Subaquatique Nantais"