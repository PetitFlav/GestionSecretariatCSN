generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Saison {
  id                String             @id @default(cuid())
  label             String             @unique
  isActive          Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  dateDebut         String
  dateExpireLicence String
  dateFin           String
  // Assemblée générale de la saison (JJ/MM/AAAA, comme les autres dates)
  dateAG            String?
  // Photo « inscrits pré-AG » : quand elle a été prise et combien de fiches
  // ont été figées (voir Adherent.inscritPreAG)
  datePhotoAG       DateTime?
  nbPhotoAG         Int?
  adherents         Adherent[]
  attestationEmails AttestationEmail[]
  impressions       Impression[]
  rappelsCaci       RappelCaci[]
  validations       ValidationFFESSM[]
  // Demande d'accueil piscine (relations virtuelles, aucune colonne)
  modeleDemande     ModeleDemande?
  demandesAccueil   DemandeAccueil[]

  @@map("saisons")
}

model Adherent {
  id                String             @id @default(cuid())
  saisonId          String
  nom               String
  prenom            String
  montant           String?
  dateExpiration    String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  adresseDesync     Boolean            @default(false)
  adresseEnc        String?
  civilite          String?
  codePostalEnc     String?
  dateNaissanceEnc  String?
  datePaiement      String?
  emailEnc          String?
  ffessmId          String?
  licence           String?
  villeEnc          String?
  caci              String?
  // DÉPRÉCIÉ — remplacé par `statut` (passager=true ⇒ statut=EXTERNE).
  // Conservé le temps de la migration des données, à supprimer ensuite.
  passager          Boolean            @default(false)
  statut            StatutAdherent     @default(LICENCIE)
  // Déblocage manuel : la personne est bien licenciée FFESSM mais la jointure
  // automatique ne la retrouve pas (nom divergent, licence mal saisie…).
  ffessmForce       Boolean            @default(false)
  ffessmForceNote   String?
  section           String?
  // Section corrigée/saisie à la main depuis la fiche : l'import du
  // formulaire d'adhésions ne l'écrase plus tant que ce flag est à true.
  sectionManuelle   Boolean            @default(false)
  saison            Saison             @relation(fields: [saisonId], references: [id], onDelete: Cascade)
  attestationEmails AttestationEmail[]
  impressions       Impression[]
  rappelsCaci       RappelCaci[]
  validation        ValidationFFESSM?
  // ISO "AAAA-MM-JJ" — VPdive "1ère inscription"
  datePremiereInscription String?            
  // Photo pré-AG : true = membre actif de la saison au moment de la photo
  // (bouton dans Gestion des saisons, la veille de l'AG). Jamais modifié par
  // l'import → sert à comparer les saisons « à l'AG » d'une année sur l'autre.
  inscritPreAG      Boolean            @default(false)
  // Date à laquelle la fiche est devenue ACTIVE dans la saison (dateExpiration
  // = dateExpireLicence de la saison), constatée à l'import. Posée une seule
  // fois, jamais modifiée ensuite → courbe de progression des inscriptions.
  // Précision = fréquence des imports. Antérieur au 21/10/2026 : reconstruit
  // (prisma/sql/2026-10-date-activation.sql), donc approximatif.
  dateActivation    DateTime?
  // Demande d'accueil piscine : relations virtuelles, AUCUNE colonne ajoutée
  // à la table adherents (contrainte de la spec).
  fonctions           AdherentFonction[]
  demandesResponsable DemandeResponsableAccueil[]

  @@unique([saisonId, nom, prenom])
  @@index([saisonId])
  @@index([nom, prenom])
  @@map("adherents")
}

model Impression {
  id          String      @id @default(cuid())
  adherentId  String
  saisonId    String
  zplChecksum String?
  status      PrintStatus @default(PRINTED)
  printedAt   DateTime    @default(now())
  adherent    Adherent    @relation(fields: [adherentId], references: [id], onDelete: Cascade)
  saison      Saison      @relation(fields: [saisonId], references: [id], onDelete: Cascade)

  @@index([adherentId, saisonId])
  @@index([saisonId])
  @@index([status, printedAt])
  @@map("impressions")
}

model AttestationEmail {
  id         String   @id @default(cuid())
  adherentId String
  saisonId   String
  email      String?
  sentAt     DateTime @default(now())
  adherent   Adherent @relation(fields: [adherentId], references: [id], onDelete: Cascade)
  saison     Saison   @relation(fields: [saisonId], references: [id], onDelete: Cascade)

  @@index([adherentId, saisonId])
  @@index([sentAt])
  @@map("attestation_emails")
}

model ValidationFFESSM {
  id            String       @id @default(cuid())
  adherentId    String       @unique
  saisonId      String
  statut        StatutFFESSM @default(NON_SOUMIS)
  validateur    String?
  updatedAt     DateTime     @updatedAt
  adresseEnc    String?
  codePostalEnc String?
  villeEnc      String?
  adherent      Adherent     @relation(fields: [adherentId], references: [id], onDelete: Cascade)
  saison        Saison       @relation(fields: [saisonId], references: [id], onDelete: Cascade)

  @@index([saisonId, statut])
  @@map("validations_ffessm")
}

model User {
  id               String          @id @default(cuid())
  firstName        String          @default("")
  lastName         String          @default("")
  email            String          @unique
  passwordHash     String          @default("")
  role             UserRole        @default(USER)
  status           UserStatus      @default(PENDING)
  setupToken       String?
  setupTokenExpiry DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  smtpConfig       UserSmtpConfig?
  // Demandes d'accueil piscine créées par cet utilisateur (relation virtuelle)
  demandesAccueil  DemandeAccueil[]

  @@map("users")
}

model UserSmtpConfig {
  id          String   @id @default(cuid())
  userId      String   @unique
  provider    String?
  hostEnc     String?
  portEnc     String?
  secureEnc   String?
  userEnc     String?
  passwordEnc String?
  fromEnc     String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_smtp_configs")
}

model RappelCaci {
  id         String   @id @default(cuid())
  adherentId String
  saisonId   String
  email      String?
  sentAt     DateTime @default(now())
  adherent   Adherent @relation(fields: [adherentId], references: [id], onDelete: Cascade)
  saison     Saison   @relation(fields: [saisonId], references: [id], onDelete: Cascade)

  @@index([adherentId])
  @@index([saisonId])
  @@map("rappels_caci")
}

// ═══ Demande d'accueil piscine Léo Lagrange ═══════════════════
// Spec : docs/SPEC-demande-accueil.md

// ─── Référentiels (alimentés par SQL, pas d'écran) ───────────

model TypeDemande {
  id       String           @id @default(cuid())
  code     String           @unique
  // Texte imprimé dans le champ type_demande du PDF
  libelle  String
  ordre    Int              @default(0)
  // Pour retirer un type : actif = false (suppression bloquée s'il est utilisé)
  actif    Boolean          @default(true)
  demandes DemandeAccueil[]

  @@map("types_demande")
}

model Fonction {
  id           String             @id @default(cuid())
  // PRESIDENT, SECRETAIRE, TRESORIER, CODIR
  code         String             @unique
  libelle      String
  ordre        Int                @default(0)
  actif        Boolean            @default(true)
  affectations AdherentFonction[]

  @@map("fonctions")
}

// Fonction au bureau d'un adhérent. Pas de saisonId : la fiche Adherent
// est déjà propre à une saison.
model AdherentFonction {
  id         String   @id @default(cuid())
  adherentId String
  fonctionId String
  createdAt  DateTime @default(now())
  adherent   Adherent @relation(fields: [adherentId], references: [id], onDelete: Cascade)
  fonction   Fonction @relation(fields: [fonctionId], references: [id], onDelete: Restrict)

  @@unique([adherentId, fonctionId])
  @@index([fonctionId])
  @@map("adherents_fonctions")
}

model DestinataireDemande {
  id          String  @id @default(cuid())
  nom         String
  prenom      String?
  email       String  @unique
  // "Chef de bassin", "Direction", "Secrétaire"
  role        String?
  ordre       Int     @default(0)
  // Mémorise les cases cochées lors du dernier envoi
  selectionne Boolean @default(true)
  // false = plus proposé (on ne supprime pas)
  actif       Boolean @default(true)

  @@map("destinataires_demande")
}

// Téléphones saisis dans l'écran d'envoi, réutilisés d'un envoi à l'autre.
// Clé = makeKey(nom, prenom) → survit au changement de saison.
model ContactDemande {
  id           String   @id @default(cuid())
  cle          String   @unique
  nom          String
  prenom       String
  telephoneEnc String
  updatedAt    DateTime @updatedAt

  @@map("contacts_demande")
}

// ─── Modèle PDF par saison ───────────────────────────────────

model ModeleDemande {
  id        String           @id @default(cuid())
  saisonId  String           @unique
  pdf       Bytes
  // Style par champ (taille, couleur, alignement, décalage dy)
  champs    Json
  updatedAt DateTime         @updatedAt
  saison    Saison           @relation(fields: [saisonId], references: [id], onDelete: Restrict)
  demandes  DemandeAccueil[]

  @@map("modeles_demande")
}

// ─── Historique des demandes ─────────────────────────────────

model DemandeAccueil {
  id            String        @id @default(cuid())
  saisonId      String
  typeDemandeId String
  modeleId      String
  creeParId     String
  // @db.Date : revient à minuit UTC → formater avec timeZone 'UTC'
  dateSouhaitee DateTime      @db.Date
  // "09:00"
  heureDebut    String
  // "10:30"
  heureFin      String
  nbAdultes     Int
  nbEnfants     Int
  // Emails réellement utilisés (À / CC)
  destinataires String[]
  cc            String[]
  // PDF exact envoyé (jamais chargé dans la liste de l'historique)
  pdf           Bytes?
  statut        StatutDemande @default(BROUILLON)
  erreur        String?
  envoyeeLe     DateTime?
  createdAt     DateTime      @default(now())

  saison       Saison                      @relation(fields: [saisonId], references: [id], onDelete: Restrict)
  typeDemande  TypeDemande                 @relation(fields: [typeDemandeId], references: [id], onDelete: Restrict)
  modele       ModeleDemande               @relation(fields: [modeleId], references: [id], onDelete: Restrict)
  creePar      User                        @relation(fields: [creeParId], references: [id], onDelete: Restrict)
  responsables DemandeResponsableAccueil[]

  @@index([saisonId, dateSouhaitee])
  @@map("demandes_accueil")
}

// Responsables de l'accueil (1 ou 2). Le nom est figé à l'envoi : si la
// fiche adhérent est supprimée, adherentId passe à NULL mais le nom reste.
model DemandeResponsableAccueil {
  id         String         @id @default(cuid())
  demandeId  String
  // 1 ou 2 → champ responsable_accueil_1 / _2 (CHECK posé par le script SQL)
  ordre      Int
  adherentId String?
  // "Prénom NOM" au moment de l'envoi
  nom        String
  demande    DemandeAccueil @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  adherent   Adherent?      @relation(fields: [adherentId], references: [id], onDelete: SetNull)

  @@unique([demandeId, ordre])
  @@unique([demandeId, adherentId])
  @@map("demandes_responsables_accueil")
}

enum StatutAdherent {
  LICENCIE  // licence + adhésion au CSN
  EXTERNE   // adhésion CSN, licence prise dans un autre club
  PASSAGER  // licence via le CSN, sans adhésion (pas d'accès aux entraînements)
}

enum PrintStatus {
  PRINTED
  SIMULATED
}

enum StatutFFESSM {
  VALIDE
  EN_ATTENTE
  NON_SOUMIS
}

enum UserRole {
  USER
  ADMIN
  SUPERUSER
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum StatutDemande {
  BROUILLON // créée au clic sur « Envoyer », avant l'envoi
  ENVOYEE
  ERREUR
}
